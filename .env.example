# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider: auto | mock | openai | deepseek | gateway
# En Vercel (auto) se usa AI Gateway + OIDC. No hace falta copiar OPENAI_API_KEY.
AI_PROVIDER=auto

# Modelo DeepSeek a través de Vercel AI Gateway
AI_GATEWAY_MODEL=deepseek/deepseek-v4-flash

# Solo para desarrollo local fuera de Vercel, o si no hay OIDC:
# OPENAI_API_KEY = clave DeepSeek (misma convención que otros proyectos)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Clave estática del Gateway (opcional). En Vercel el OIDC cubre esto.
AI_GATEWAY_API_KEY=

# Reserved for later providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Knowledge RAG (file-based TF-IDF index in data/knowledge/)
# Run `npm run rag:ingest` after editing data/knowledge/chunks.json
KNOWLEDGE_CORPUS_PATH=data/knowledge/chunks.json
KNOWLEDGE_VECTOR_INDEX_PATH=data/knowledge/vector-index.json

# coches.net: scraping SSR de resultados de segunda mano (mercado España).
# No requiere API key. El runtime cachea ~30 min (revalidate).

# Consulta por matrícula (marca, modelo, año). Configura al menos una:
# VERIFIK_API_TOKEN — https://docs.verifik.co/verifik-es/validacion-vehiculos/espana/
# OPENAPI_AUTOMOTIVE_TOKEN — https://console.openapi.com/apis/automotive/documentation (ES-car)
# OPENAPI_AUTOMOTIVE_BASE_URL=https://automotive.openapi.com
# RAPIDAPI_KEY — Matrículas.org en RapidAPI (api-license-plate.p.rapidapi.com/es)
VERIFIK_API_TOKEN=
OPENAPI_AUTOMOTIVE_TOKEN=
OPENAPI_AUTOMOTIVE_BASE_URL=
RAPIDAPI_KEY=

# Analysis persistence (chat /vehicle/[id] across serverless invocations)
# auto: Upstash Redis if configured; else file store locally; memory-only on Vercel without Redis
ANALYSIS_STORE=auto
ANALYSIS_TTL_SECONDS=604800
# ANALYSIS_STORE_DIR=.data/analyses

# Upstash Redis (Vercel Marketplace → Upstash). Required for persistence on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy Vercel KV aliases (also supported):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional external vector DB (not wired in this MVP)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
REDIS_URL=
VECTOR_DATABASE_URL=
