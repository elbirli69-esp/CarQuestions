# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider: auto | mock | openai | deepseek | gateway
# auto uses the first configured key, otherwise the demo assistant.
AI_PROVIDER=auto

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (optional, OpenAI-compatible)
DEEPSEEK_API_KEY=

# Vercel AI Gateway (optional)
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Reserved for later providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Future data stores (not used in the MVP)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
REDIS_URL=
VECTOR_DATABASE_URL=
