# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider: auto | mock | openai | deepseek | gateway
# auto usa OPENAI_API_KEY si existe; si no, el asistente de demostración.
AI_PROVIDER=auto

# Misma convención que el resto de proyectos:
# OPENAI_API_KEY = clave de DeepSeek (API compatible con OpenAI).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Alias opcional. Si OPENAI_API_KEY está vacío, se usa esta.
DEEPSEEK_API_KEY=

# Vercel AI Gateway (opcional)
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Reserved for later providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Future data stores (not used in the MVP)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
REDIS_URL=
VECTOR_DATABASE_URL=
